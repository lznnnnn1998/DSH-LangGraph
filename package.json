{
  "name": "@lzn1998/dsh-langgraph",
  "version": "1.4.0",
  "type": "module",
  "description": "Durable LangGraph graphs as DSH tools: register TS/JS graphs, advertise them in the system prompt, run, resume and time-travel them, give them durable long-term memory, ask the user in the native question UI, run them as background jobs, delegate to DSH subagents, trace every node/tool/model call in Trajectory, draw their topology in a Web panel, and let graph nodes call this session's own tools.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lznnnnn1998/DSH-LangGraph.git"
  },
  "homepage": "https://github.com/lznnnnn1998/DSH-LangGraph#readme",
  "bugs": {
    "url": "https://github.com/lznnnnn1998/DSH-LangGraph/issues"
  },
  "license": "MIT",
  "author": "lznnnnn1998",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "compose",
    "dsh-checkpointer.js",
    "dsh-chat-model.js",
    "dsh-store.js",
    "dsh-tools.js",
    "dsh-trace.js",
    "graphs",
    "locale",
    "docs",
    "lib/client.js",
    "client/index.tsx",
    "scripts/build-client.mjs",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.5 <0.3.0",
    "node": ">=24.9.0"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "build:client": "node scripts/build-client.mjs"
  },
  "dependencies": {
    "@langchain/core": "^1.5.1",
    "@langchain/langgraph": "^1.7.5",
    "@langchain/langgraph-checkpoint": "^1.2.3",
    "zod": "^4.6.7"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
